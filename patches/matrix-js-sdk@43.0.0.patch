+++ b/lib/models/event-timeline-set.js
@@ -287,6 +287,16 @@ export class EventTimelineSet extends TypedEventEmitter {
     if (!timeline) {
       throw new Error("'timeline' not specified for EventTimelineSet.addEventsToTimeline");
     }
+    // CIRQLE: a page that comes back for a timeline this set has since dropped (a limited sync reset
+    // every timeline while the page was on its way) is thrown away. Added, it put its events in the new
+    // event map pointing at the dropped timeline, the next back-pagination joined that timeline to the
+    // live one, and the chat showed its old copies again: messages twice or more, deleted ones with
+    // their text (redactions look events up through the map and never reach them).
+    if (!this.timelines.includes(timeline)) {
+      logger.info(`Ignoring ${events.length} events paginated into timeline ${timeline}, which was reset`);
+      timeline.setPaginationToken(null, toStartOfTimeline ? EventTimeline.BACKWARDS : EventTimeline.FORWARDS);
+      return;
+    }
     if (!toStartOfTimeline && timeline == this.liveTimeline) {
       throw new Error("EventTimelineSet.addEventsToTimeline cannot be used for adding events to " + "the live timeline - use Room.addLiveEvents instead");
     }
