SPDX-License-Identifier: AGPL-3.0-only

New chat and New group panels, Group info (concept artboards NewChat and GroupInfo);
Contact info and the member card share Group info's look.
*/

/* ---------- new chat ---------- */

.cirqle_NewChat {
    height: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-right: 1px solid var(--cirqle-line);
    color: var(--cirqle-ink);
}

.cirqle_NewChat > * {
    flex: 0 0 auto;
}

.cirqle_NewChat_header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 16px 12px 12px;
}

.cirqle_NewChat_back {
    width: 44px;
    height: 44px;
    border-radius: 22px;
}

.cirqle_NewChat_title {
    margin: 0;
    font-family: var(--cirqle-serif);
    font-weight: 600;
    font-size: 24px;
    line-height: normal;
    color: var(--cirqle-green);
}

.cirqle_NewChat_search {
    margin-bottom: 12px;
}

.cirqle_NewChat_search:focus-within {
    box-shadow: inset 0 0 0 2px var(--cirqle-green);
}

.cirqle_NewChat_search input {
    font-size: 15px;
}

.cirqle_NewChat_from {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px 14px 20px;
}

.cirqle_NewChat_from label {
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: 13px;
    color: var(--cirqle-ink-2);
}

.cirqle_NewChat_from select {
    flex: 1 1 auto;
    min-width: 0;
    height: 36px;
    padding: 0 10px;
    border-radius: 10px;
    border: 1px solid var(--cirqle-pill-line);
    background: var(--cirqle-pill);
    font: inherit;
    font-size: 14px;
    color: var(--cirqle-ink);
}

.cirqle_NewChat_hint {
    margin: -6px 16px 12px 20px;
    font-size: 13px;
    color: var(--cirqle-danger);
}

/* A number typed without its country code: a note, not an error */
.cirqle_NewChat_note {
    margin: -6px 16px 12px 20px;
    font-size: 13px;
    color: var(--cirqle-ink-3);
}

.cirqle_NewChat > .cirqle_NewChat_rows {
    flex: 1 1 0;
    min-height: 0;
    overflow-y: auto;
}

.cirqle_NewChat_row {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 20px;
    border: 0;
    background: #ffffff;
    font: inherit;
    text-align: left;
    color: var(--cirqle-ink);
    cursor: pointer;
}

.cirqle_NewChat_row:hover {
    background: #f7f6f2;
}

.cirqle_NewChat_found {
    padding: 10px 20px;
    background: var(--cirqle-green-selected);
}

.cirqle_NewChat_action {
    padding: 12px 20px;
}

.cirqle_NewChat_action:first-of-type,
.cirqle_NewChat_found + .cirqle_NewChat_action {
    margin-top: 6px;
}

.cirqle_NewChat_actionIcon {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--cirqle-green);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
}

.cirqle_NewChat_actionLabel {
    font-size: 16px;
    font-weight: 500;
}

.cirqle_NewChat_text {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.cirqle_NewChat_text_ruled {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--cirqle-line-soft);
}

.cirqle_NewChat_name {
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cirqle_NewChat_sub {
    font-size: 13px;
    color: var(--cirqle-ink-3);
}

.cirqle_NewChat_sub_green {
    color: var(--cirqle-green-hover);
}

.cirqle_NewChat_section {
    padding: 18px 20px 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--cirqle-green-hover);
}

/* ---------- new group ---------- */

.cirqle_NewGroup {
    position: relative;
}

.cirqle_NewGroup_chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    max-height: 120px;
    overflow-y: auto;
    margin: 0;
    padding: 0 16px 12px 20px;
    list-style: none;
}

.cirqle_NewGroup_chip {
    max-width: 100%;
    height: 32px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 4px;
    border-radius: 16px;
    background: var(--cirqle-green-soft);
    font-size: 14px;
}

.cirqle_NewGroup_chipName {
    max-width: 160px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cirqle_NewGroup_chip button {
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--cirqle-ink-3);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.cirqle_NewGroup_chip button:hover {
    background: rgba(14, 59, 46, 0.12);
    color: var(--cirqle-ink);
}

.cirqle_NewGroup > .cirqle_NewChat_rows {
    padding-bottom: 88px;
}

.cirqle_NewGroup_row[aria-pressed="true"] {
    background: var(--cirqle-green-selected);
}

.cirqle_NewGroup_tick {
    flex: 0 0 22px;
    display: flex;
    color: var(--cirqle-green);
}

.cirqle_NewGroup_next {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 56px;
    height: 56px;
    border: 0;
    border-radius: 28px;
    background: var(--cirqle-green);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 18px rgba(14, 59, 46, 0.28);
    cursor: pointer;
}

.cirqle_NewGroup_next:disabled,
.cirqle_NewGroup_create:disabled {
    background: var(--cirqle-pill-line);
    box-shadow: none;
    cursor: default;
}

.cirqle_NewGroup_nameField {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 6px 10px;
    padding: 8px 20px 14px;
}

.cirqle_NewGroup_nameField label {
    grid-column: 1 / -1;
    font-size: 13px;
    color: var(--cirqle-ink-2);
}

.cirqle_NewGroup_nameField input {
    min-width: 0;
    height: 40px;
    padding: 0 2px;
    border: 0;
    border-bottom: 2px solid var(--cirqle-green);
    background: transparent;
    font: inherit;
    font-size: 16px;
    color: var(--cirqle-ink);
    outline: none;
}

.cirqle_NewGroup_count {
    font-size: 13px;
    color: var(--cirqle-ink-3);
}

.cirqle_NewGroup_summary {
    margin: 0 20px 14px;
    font-size: 13px;
    color: var(--cirqle-ink-3);
}

.cirqle_NewGroup_creating {
    margin: 0 20px 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--cirqle-green-hover);
}

.cirqle_NewGroup_create {
    align-self: flex-start;
    height: 40px;
    margin: 0 20px;
    padding: 0 22px;
    border: 0;
    border-radius: 20px;
    background: var(--cirqle-green);
    color: #ffffff;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
}

/* ---------- group info ---------- */

.mx_RightPanel:has(.cirqle_GroupInfo) {
    background: var(--cirqle-ground);
}

.cirqle_GroupInfo {
    height: 100%;
    overflow-y: auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--cirqle-ground);
    border-left: 1px solid var(--cirqle-line);
    color: var(--cirqle-ink);
}

.cirqle_GroupInfo > * {
    flex: 0 0 auto;
}

.cirqle_GroupInfo_bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: #ffffff;
}

.cirqle_GroupInfo_bar .cirqle_iconButton {
    width: 44px;
    height: 44px;
    border-radius: 22px;
}

.cirqle_GroupInfo_barTitle {
    font-size: 16px;
    font-weight: 600;
}

.cirqle_GroupInfo_card {
    background: #ffffff;
    display: flex;
    flex-direction: column;
}

.cirqle_GroupInfo_identity {
    align-items: center;
    gap: 6px;
    padding: 20px;
    text-align: center;
}

.cirqle_GroupInfo_name {
    margin: 8px 0 0;
    font-family: var(--cirqle-serif);
    font-weight: 600;
    font-size: 22px;
    line-height: normal;
    color: var(--cirqle-green);
}

.cirqle_GroupInfo_sub {
    font-size: 13px;
    color: var(--cirqle-ink-3);
}

.cirqle_GroupInfo_phone {
    font-size: 15px;
    color: var(--cirqle-ink-2);
}

.cirqle_GroupInfo_phoneLine {
    display: flex;
    align-items: center;
    gap: 8px;
}

.cirqle_GroupInfo_copy {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 26px;
    padding: 0 10px;
    border-radius: 13px;
    border: 1px solid var(--cirqle-pill-line);
    background: #ffffff;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    color: var(--cirqle-green-hover);
    cursor: pointer;
}

.cirqle_GroupInfo_copy:hover {
    background: var(--cirqle-green-soft);
}

.cirqle_GroupInfo_message {
    margin-top: 10px;
    height: 36px;
    padding: 0 22px;
    border: 0;
    border-radius: 18px;
    background: var(--cirqle-green);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    cursor: pointer;
}

.cirqle_GroupInfo_message:hover {
    background: var(--cirqle-green-hover);
}

.cirqle_GroupInfo_action {
    padding: 14px 20px;
    cursor: pointer;
}

.cirqle_GroupInfo_action:hover {
    background: #f7f6f2;
}

.cirqle_GroupInfo_action svg {
    flex: 0 0 auto;
    color: var(--cirqle-ink-3);
}

.cirqle_GroupInfo_actionLabel {
    flex: 1 1 auto;
    font-size: 15px;
}

.cirqle_GroupInfo_switch {
    flex: 0 0 36px;
    height: 20px;
    border-radius: 10px;
    background: var(--cirqle-pill-line);
    position: relative;
    transition: background 0.15s;
}

.cirqle_GroupInfo_switch::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #ffffff;
    transition: transform 0.15s;
}

.cirqle_GroupInfo_action[aria-checked="true"] .cirqle_GroupInfo_switch {
    background: var(--cirqle-green);
}

.cirqle_GroupInfo_action[aria-checked="true"] .cirqle_GroupInfo_switch::after {
    transform: translateX(16px);
}

.cirqle_GroupInfo_section {
    padding: 14px 20px 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--cirqle-green-hover);
}

.cirqle_GroupInfo_row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 12px 8px 20px;
    border: 0;
    background: #ffffff;
    font: inherit;
    text-align: left;
    color: var(--cirqle-ink);
}

.cirqle_GroupInfo_add {
    padding: 10px 20px;
    cursor: pointer;
}

.cirqle_GroupInfo_addIcon {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
}

.cirqle_GroupInfo_addLabel {
    font-size: 15px;
    font-weight: 600;
}

.cirqle_GroupInfo_text {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.cirqle_GroupInfo_memberName {
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cirqle_GroupInfo_memberSub {
    font-size: 13px;
    color: var(--cirqle-ink-3);
}

.cirqle_GroupInfo_admin {
    flex: 0 0 auto;
    font-size: 12px;
    font-weight: 600;
    color: var(--cirqle-green-hover);
    background: var(--cirqle-green-soft);
    border-radius: 6px;
    padding: 3px 8px;
}

/* A member: the row opens their card; the arrow beside it, where our number is
   a group admin, opens Make group admin / Dismiss as admin / Remove, as in WhatsApp */
.cirqle_GroupInfo_member {
    padding: 0 8px 0 0;
    gap: 0;
}

.cirqle_GroupInfo_memberOpen {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 8px 8px 20px;
    border: 0;
    background: transparent;
    font: inherit;
    text-align: left;
    color: inherit;
    cursor: pointer;
}

.cirqle_GroupInfo_member:hover {
    background: #f7f6f2;
}

.cirqle_GroupInfo_memberMenu {
    flex: 0 0 auto;
    color: var(--cirqle-ink-3);
}

.cirqle_GroupInfo_leave {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    border: 0;
    background: #ffffff;
    font: inherit;
    font-size: 15px;
    color: var(--cirqle-danger);
    text-align: left;
    cursor: pointer;
}

/* "Delete message from Anna?": WhatsApp's stacked choices, right-aligned (CirqleDeleteDialog) */
.cirqle_DeleteDialog_text {
    margin: 0 0 20px;
    color: var(--cirqle-ink-2);
}

.cirqle_DeleteDialog_buttons {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
}

.cirqle_DeleteDialog_button {
    min-width: 180px;
    height: 40px;
    padding: 0 20px;
    border-radius: 20px;
    border: 1px solid var(--cirqle-pill-line);
    background: #ffffff;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: var(--cirqle-green-hover);
    cursor: pointer;
}

.cirqle_DeleteDialog_button:hover {
    background: var(--cirqle-green-soft);
}

.cirqle_DeleteDialog_cancel {
    border-color: transparent;
    color: var(--cirqle-ink-2);
}

.cirqle_DeleteDialog {
    max-width: 480px;
}
