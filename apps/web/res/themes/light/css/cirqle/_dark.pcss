/*
Copyright 2026 CIRQLE.

SPDX-License-Identifier: AGPL-3.0-only

CIRQLE Messenger in Element's dark theme (VLA-756): the rules of _cirqle.pcss
with a graphite palette, after the owner's sample of 2026-11-03 (almost black
ground, slightly lighter panels, the green of the buttons and of own messages,
light text). Imported unlayered after _cirqle.pcss at the end of dark.pcss.
Text colours keep WCAG AA contrast on the panels and bubbles they sit on.
*/

:root,
.cpd-theme-dark {
    --cirqle-green: #23825d;
    --cirqle-green-hover: #4cc794;
    --cirqle-green-text: #4cc794;
    --cirqle-green-soft: #1f4a3b;
    --cirqle-green-selected: #26282c;
    --cirqle-ground: #0f1012;
    --cirqle-panel: #1a1b1e;
    --cirqle-hover: #232428;
    --cirqle-bubble-other: #26282c;
    --cirqle-pill: #232428;
    --cirqle-line: #2e3035;
    --cirqle-line-soft: #26282c;
    --cirqle-pill-line: #3a3d42;
    --cirqle-ink: #e9eaec;
    --cirqle-ink-2: #c3c5c9;
    --cirqle-ink-3: #9a9ea4;
    --cirqle-whatsapp: #4cc794;
    --cirqle-on-whatsapp: #0f1012;
    --cirqle-telegram: #5aa9e6;
    --cirqle-danger: #ef7d72;
    --cirqle-whatsapp-soft: #1f4a3b;
    --cirqle-telegram-soft: #1b2e42;
    --cirqle-rail: #141518;
    --cirqle-waveform: #5a5e64;
    --cirqle-own-muted: #9fc4b2;

    /* White text on the green buttons, readable at rest, hovered or pressed */
    --cpd-color-text-on-solid-primary: #ffffff;
    --cpd-color-bg-action-primary-hovered: #1d6e50;
    --cpd-color-bg-action-primary-pressed: #1d6e50;
    --cpd-color-bg-accent-rest: var(--cirqle-green);
    --cpd-color-bg-accent-hovered: #1d6e50;

    /* The same white on the red danger buttons ("Sign out", "Delete"): the reds of the light theme, readable at rest, hovered or pressed */
    --cpd-color-bg-critical-primary: #d51928;
    --cpd-color-bg-critical-hovered: #bc0f22;
    --cpd-color-bg-critical-pressed: #a4041d;

    color-scheme: dark;
}

/* Titles in light ink, as in the sample, rather than green */
.cirqle_ChatList_title,
.cirqle_NewChat_title,
.cirqle-heading,
.mx_Dialog_title {
    color: var(--cirqle-ink);
}

.cirqle_GroupInfo_message:hover {
    background: #1d6e50;
}

/* The time and "This message was deleted" in an own bubble: the grey falls under AA on the dark green */
[class*="_layoutBubble_"][class*="_stateOwnEvent_"] [data-testid="event-tile-slot-timestamp"] > *,
[class*="_layoutBubble_"][class*="_stateOwnEvent_"] .mx_RedactedBody {
    color: var(--cirqle-own-muted);
}

/* "Replying" over the composer: Element dims it with opacity, under AA on the dark panel */
.mx_ReplyPreview .mx_ReplyPreview_header {
    color: var(--cirqle-ink-3);
    opacity: 1;
}

/* Letter avatars in the green of the sample, instead of Compound's decorative colours */
.mx_BaseAvatar[data-color] {
    --cpd-avatar-bg: var(--cirqle-green-soft);
    --cpd-avatar-color: var(--cirqle-green-text);
}

/* Tooltips on a dark panel, instead of Compound's inverted light ones */
[class*="_tooltip_"] {
    background: var(--cirqle-hover);
    color: var(--cirqle-ink);
    outline: 1px solid var(--cirqle-pill-line);
}

[class*="_tooltip_"] [class*="_arrow_"] {
    fill: var(--cirqle-hover);
}

/* An error in an own bubble ("Unable to show image…") in a lighter red, readable on the dark green */
[class*="_layoutBubble_"][class*="_stateOwnEvent_"] {
    --cpd-color-text-critical-primary: #ffb3ab;
}

/* The chat's number and network beside a name in Forward: Element's tertiary grey is under AA here */
.mx_ForwardList_entry_detail {
    color: var(--cirqle-ink-3);
}

/* Bot commands from the Telegram bridge ("/newbot") come with an inline dark blue, under AA on both bubbles */
.mx_EventTile_body [style*="rgb(55, 113, 187)"],
.mx_EventTile_body [style*="#3771bb" i] {
    color: #93bbf5 !important;
}

/* The unread count on the jump-to-bottom button: white on Element's light grey and red is under AA */
.mx_JumpToBottomButton_badge {
    background-color: #656d77;
}

.mx_JumpToBottomButton_highlight .mx_JumpToBottomButton_badge {
    background-color: var(--cpd-color-bg-critical-primary);
}
