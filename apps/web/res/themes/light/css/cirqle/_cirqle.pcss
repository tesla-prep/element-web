/*
Copyright 2026 CIRQLE.

SPDX-License-Identifier: AGPL-3.0-only

CIRQLE Messenger look, drawn over Element's light theme.

This file is imported WITHOUT a cascade layer at the end of light.pcss. Element's
own styles all live in layers, so every rule here wins over them whatever its
specificity, and upstream CSS can change underneath without this file needing
!important.
*/

@font-face {
    font-family: "Source Serif 4";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("/res/fonts/Source_Serif_4/SourceSerif4-SemiBold-cyrillic.woff2") format("woff2");
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
}

@font-face {
    font-family: "Source Serif 4";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("/res/fonts/Source_Serif_4/SourceSerif4-SemiBold-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329,
        U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

/* Compound sets its tokens on body.cpd-theme-light, so they are overridden there too. */
:root,
.cpd-theme-light {
    /* CIRQLE palette, from the owner-approved concept */
    --cirqle-green: #0e3b2e;
    --cirqle-green-hover: #145a45;
    --cirqle-green-soft: #d7ecdf;
    --cirqle-green-selected: #eef3ef;
    --cirqle-ground: #f3f0e8;
    --cirqle-pill: #f7f5ef;
    --cirqle-line: #e4e1d8;
    --cirqle-line-soft: #efece4;
    --cirqle-pill-line: #d6d2c6;
    --cirqle-ink: #142019;
    --cirqle-ink-2: #3e4a44;
    --cirqle-ink-3: #5b6660;
    --cirqle-whatsapp: #17784f;
    --cirqle-telegram: #1e6fb8;
    --cirqle-danger: #8a2a2a;
    --cirqle-serif: "Source Serif 4", Georgia, serif;

    --cpd-font-family-sans: "Inter", var(--emoji-font-family), "Apple Color Emoji", "Segoe UI Emoji", "Arial",
        "Helvetica", sans-serif, "Noto Color Emoji";

    --cpd-color-text-primary: var(--cirqle-ink);
    --cpd-color-text-secondary: var(--cirqle-ink-3);
    --cpd-color-text-action-primary: var(--cirqle-ink);
    --cpd-color-text-action-accent: var(--cirqle-green-hover);
    --cpd-color-text-link-external: var(--cirqle-green-hover);
    --cpd-color-text-success-primary: var(--cirqle-whatsapp);
    --cpd-color-text-badge-accent: var(--cirqle-green);

    --cpd-color-bg-canvas-default: #ffffff;
    --cpd-color-bg-subtle-primary: var(--cirqle-line-soft);
    --cpd-color-bg-subtle-secondary: var(--cirqle-ground);
    --cpd-color-bg-action-primary-rest: var(--cirqle-green);
    --cpd-color-bg-action-primary-hovered: var(--cirqle-green-hover);
    --cpd-color-bg-action-primary-pressed: var(--cirqle-green-hover);
    --cpd-color-bg-action-tertiary-hovered: var(--cirqle-ground);
    --cpd-color-bg-action-tertiary-selected: var(--cirqle-green-selected);
    --cpd-color-bg-accent-rest: var(--cirqle-whatsapp);
    --cpd-color-bg-accent-hovered: var(--cirqle-green-hover);
    --cpd-color-bg-accent-pressed: var(--cirqle-green);
    --cpd-color-bg-accent-selected: var(--cirqle-green-soft);
    --cpd-color-bg-success-subtle: var(--cirqle-green-soft);
    --cpd-color-bg-badge-accent: var(--cirqle-green-soft);

    --cpd-color-border-focused: var(--cirqle-green);
    --cpd-color-border-accent-primary: var(--cirqle-green);
    --cpd-color-border-accent-subtle: var(--cirqle-green-soft);
    --cpd-color-border-interactive-secondary: var(--cirqle-pill-line);

    --cpd-color-icon-accent-primary: var(--cirqle-whatsapp);
    --cpd-color-icon-accent-tertiary: var(--cirqle-whatsapp);
    --cpd-color-icon-success-primary: var(--cirqle-whatsapp);
}

body {
    color: var(--cirqle-ink);
}

/* Headings in the CIRQLE serif */
.mx_Dialog_title,
.mx_HomePage h1,
.mx_HomePage h2,
.cirqle-heading {
    font-family: var(--cirqle-serif);
    font-weight: 600;
    color: var(--cirqle-green);
}

/* Conversation sits on the warm ground */
.mx_RoomView_body,
.mx_RoomView_messagePanel,
.mx_HomePage {
    background-color: var(--cirqle-ground);
}

/* Until the CIRQLE rail replaces it, the space bar wears the deep green */
.mx_SpacePanel {
    background-color: var(--cirqle-green);
    --cpd-color-icon-secondary: #d7e4dc;
    --cpd-color-icon-tertiary: #d7e4dc;
    --cpd-color-text-primary: #ffffff;
    --cpd-color-text-secondary: #d7e4dc;
}

/* Calls, threads and the room directory are not used by staff */
.mx_RoomHeader [aria-label="Video call"],
.mx_RoomHeader [aria-label="Voice call"],
.mx_LegacyRoomHeader_voiceCallButton,
.mx_LegacyRoomHeader_videoCallButton {
    display: none;
}
