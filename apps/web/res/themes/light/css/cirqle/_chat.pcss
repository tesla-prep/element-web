/*
Copyright 2026 CIRQLE.

SPDX-License-Identifier: AGPL-3.0-only

The open chat (concept artboard Main) and the empty side (artboard Empty).

Element's timeline is drawn by shared components with CSS-module class names
(_stateOwnEvent_<hash>_<line>); they are matched by their stable prefix, and
slots by their data-testid.
*/

/* ---------- header ---------- */

.mx_RoomHeader.mx_RoomHeader {
    gap: 14px;
    padding: 12px 20px;
    min-height: 66px;
    box-sizing: border-box;
    background: #ffffff;
    border-bottom: 1px solid var(--cirqle-line);
}

.mx_RoomHeader .mx_RoomHeader_info {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.mx_RoomHeader .mx_RoomHeader_heading {
    font-size: 16px;
    font-weight: 600;
    line-height: 20px;
    color: var(--cirqle-ink);
}

.cirqle_RoomHeader_subtitle {
    font-size: 13px;
    line-height: 17px;
    color: var(--cirqle-ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cirqle_RoomHeader_button {
    width: 44px;
    height: 44px;
    border-radius: 22px;
}

/* ---------- timeline ---------- */

.mx_RoomView_body,
.mx_RoomView_timeline,
.mx_RoomView_MessageList {
    background: var(--cirqle-ground);
}

/* Shared components set these on each tile's root, so they are set there too */
.mx_RoomView_body[data-layout="bubble"],
[class*="_layoutBubble_"] {
    --event-tile-bubble-other-background: #ffffff;
    --event-tile-bubble-self-background: var(--cirqle-green-soft);
    --event-tile-bubble-hover-background: transparent;
    --event-tile-bubble-corner-radius: 10px;
    --event-tile-bubble-line-max-width: 62%;
    --event-tile-bubble-margin-inline-start: max(16px, 5%);
    --event-tile-bubble-margin-inline-end: max(16px, 5%);
    --event-tile-bubble-line-margin-inline-start: 0px;
    --event-tile-bubble-line-margin-inline-end: 0px;
}

/* No avatars beside bubbles, as on WhatsApp, except senders' in groups
   (CirqleSenderAvatar): beside the first bubble of a run, and the run keeps its indent */
[class*="_layoutBubble_"]
    > [data-testid="event-tile-slot-avatar"]:not(:has(.cirqle_SenderAvatar:not(.cirqle_SenderAvatar_run))) {
    display: none;
}

[class*="_layoutBubble_"]:has(> [data-testid="event-tile-slot-avatar"] .cirqle_SenderAvatar) {
    --event-tile-bubble-margin-inline-start: max(56px, calc(5% + 40px));
}

[class*="_layoutBubble_"] > [data-testid="event-tile-slot-avatar"]:has(.cirqle_SenderAvatar) {
    inset-block-start: 0;
    inset-inline-start: -42px;
    border: 0;
}

[class*="_layoutBubble_"] > [data-testid="event-tile-slot-avatar"]:has(.cirqle_SenderAvatar) * {
    box-shadow: none;
}

.cirqle_SenderAvatar {
    display: block;
    cursor: pointer;
}

[class*="_layoutBubble_"] > [data-testid="event-tile-line"] {
    box-shadow: 0 1px 1px rgba(20, 32, 25, 0.08);
    font-size: 15px;
    line-height: 21px;
}

/* First bubble of a run: the tail corner, like the concept */
[class*="_layoutBubble_"]:not([class*="_stateContinuation_"]):not([class*="_stateOwnEvent_"])
    > [data-testid="event-tile-line"] {
    border-start-start-radius: 0;
}

[class*="_layoutBubble_"][class*="_stateOwnEvent_"]:not([class*="_stateContinuation_"])
    > [data-testid="event-tile-line"] {
    border-start-end-radius: 0;
}

/* The sender's name goes inside the bubble: sender and line share one grid
   cell that is as wide as the bubble. Staff names show on our side too. */
[class*="_layoutBubble_"]:has(> [data-testid="event-tile-slot-sender"] *) {
    display: grid;
    grid-template-columns: fit-content(var(--event-tile-bubble-line-max-width));
    justify-content: start;
}

[class*="_layoutBubble_"][class*="_stateOwnEvent_"]:has(> [data-testid="event-tile-slot-sender"] *) {
    justify-content: end;
}

[class*="_layoutBubble_"]:has(> [data-testid="event-tile-slot-sender"] *) > [data-testid="event-tile-slot-sender"],
[class*="_layoutBubble_"]:has(> [data-testid="event-tile-slot-sender"] *) > [data-testid="event-tile-line"] {
    grid-row: 1;
    grid-column: 1;
}

/* The "sent" mark of our last message stays at the edge of the row: the grid
   above has one column, and the mark in a column of its own lay past the
   screen on a phone and pushed the whole chat sideways */
[class*="_layoutBubble_"]:has(> [data-testid="event-tile-slot-sender"] *) > [class*="_slotReceipt_"] {
    position: absolute;
    inset-inline-end: 0;
    inset-block-end: 0;
}

[class*="_layoutBubble_"]:has(> [data-testid="event-tile-slot-sender"] *) > [data-testid="event-tile-line"] {
    max-width: none;
    width: auto;
    min-width: 0;
    margin-inline: 0;
    padding-top: 26px;
}

[class*="_layoutBubble_"] > [data-testid="event-tile-slot-sender"] {
    display: block;
    z-index: 4;
    align-self: start;
    max-width: calc(100% - 24px);
    margin: 6px 12px 0;
    inset: auto;
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

[class*="_layoutBubble_"] > [data-testid="event-tile-slot-sender"] * {
    font-size: 12px;
    line-height: 16px;
}

/* One line, as on WhatsApp: a long name ends in "…" rather than wrapping over the text */
[class*="_layoutBubble_"] > [data-testid="event-tile-slot-sender"] .mx_DisambiguatedProfile {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* Telegram's round video message (CirqleTimeline.ts): a small circle, as in Telegram */
.cirqle_RoundVideo .mx_MVideoBody_container {
    width: 200px !important;
    max-width: 100% !important;
    max-height: none !important;
    aspect-ratio: 1 !important;
    border-radius: 50%;
}

.cirqle_RoundVideo video {
    object-fit: cover;
}

[class*="_layoutBubble_"] > [data-testid="event-tile-line"]:has(.cirqle_RoundVideo) {
    background: transparent;
    box-shadow: none;
}

/* A customer's number after the name in a group (CirqleSenderPhone.ts), quieter, on the same line */
[class*="_layoutBubble_"] > [data-testid="event-tile-slot-sender"] .mx_DisambiguatedProfile_mxid {
    color: var(--cirqle-ink-3);
    font-weight: 400;
}

[class*="_layoutBubble_"][class*="_stateOwnEvent_"] > [data-testid="event-tile-slot-sender"] * {
    color: var(--cirqle-green-hover);
}

/* Footer (reactions) under the bubble */
[class*="_layoutBubble_"] > [data-testid="event-tile-slot-footer"] {
    grid-column: 1;
}

.mx_ReactionsRowButton {
    height: 24px;
    padding: 0 8px;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid var(--cirqle-line);
    font-size: 12px;
    color: var(--cirqle-ink-2);
}

/* Replies: a green bar on the warm ground, inside the bubble */
.mx_ReplyChain {
    border-left: 3px solid var(--cirqle-whatsapp) !important;
    background: var(--cirqle-ground);
    border-radius: 6px;
    padding: 6px 10px;
    margin-bottom: 6px;
}

/* Joins, renames and power changes are the bridges' and the relay bot's
   plumbing (staff and service users join every chat): not shown, as WhatsApp
   shows none of it. */
.mx_RoomView_body[data-layout="bubble"] .mx_GenericEventListSummary,
[class*="_layoutBubble_"][class*="_stateInfo_"] {
    display: none;
}

/* Day dividers: small centered chips */
.mx_TimelineSeparator,
.mx_DateSeparator {
    justify-content: center;
}

.mx_DateSeparator > hr,
.mx_TimelineSeparator > hr {
    display: none;
}

.mx_DateSeparator h2,
.mx_DateSeparator [role="heading"],
.mx_TimelineSeparator > div {
    padding: 4px 12px;
    border-radius: 8px;
    background: #ffffff;
    font-size: 12px;
    font-weight: 400;
    color: var(--cirqle-ink-2);
    box-shadow: 0 1px 1px rgba(20, 32, 25, 0.08);
}

/* The "beginning of your conversation" card has no place in a WhatsApp chat */
.mx_NewRoomIntro {
    display: none;
}

/* ---------- composer ---------- */

.mx_MessageComposer.mx_MessageComposer {
    box-sizing: border-box;
    width: 100%;
    padding: 10px 16px;
    margin: 0;
    background: #ffffff;
    border-top: 1px solid var(--cirqle-line);
}

.mx_MessageComposer_wrapper {
    padding: 0;
}

.mx_MessageComposer_row {
    display: flex;
    align-items: center;
    gap: 6px;
}

.mx_MessageComposer_e2eIconWrapper {
    display: none;
}

.mx_MessageComposer_actions {
    display: contents;
}

.mx_MessageComposer_row .mx_EmojiButton {
    order: 1;
}

.mx_MessageComposer_row [aria-label="Attachment"] {
    order: 2;
}

.mx_MessageComposer_row .mx_SendMessageComposer {
    order: 3;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 44px;
    margin: 0;
    padding: 0 16px;
    box-sizing: border-box;
    border-radius: 22px;
    background: var(--cirqle-ground);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
}

.mx_MessageComposer_row .mx_BasicMessageComposer {
    flex: 1 1 auto;
    min-width: 0;
}

.mx_MessageComposer_row .mx_BasicMessageComposer_input {
    font-size: 15px;
    line-height: 21px;
    padding: 11px 0;
}

.mx_MessageComposer_row .mx_BasicMessageComposer_inputEmpty > :first-child::before {
    content: "Type a message";
    color: var(--cirqle-ink-3);
}

.mx_MessageComposer_row .mx_MessageComposer_buttonMenu {
    order: 4;
}

.mx_MessageComposer_row .cirqle_mic,
.mx_MessageComposer_row .mx_MessageComposer_sendMessage {
    order: 5;
}

.mx_MessageComposer_row > .mx_MessageComposer_actions > *,
.mx_MessageComposer_row .mx_MessageComposer_button {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cirqle-ink-2);
}

/* A chat that moved (its group was opened in WhatsApp) or one staff cannot post in:
   the notice takes the row, it is not a round button */
.mx_MessageComposer_row > .mx_MessageComposer_actions > .mx_MessageComposer_replaced_wrapper,
.mx_MessageComposer_row > .mx_MessageComposer_actions > .mx_MessageComposer_noperm_error {
    flex: 1 1 auto;
    width: auto;
    height: auto;
    min-height: 44px;
    border-radius: 0;
}

.mx_MessageComposer_row .mx_MessageComposer_button svg,
.mx_MessageComposer_row [aria-label="Attachment"] svg {
    width: 22px;
    height: 22px;
}

/* «+» instead of the paperclip */
.mx_MessageComposer_row [aria-label="Attachment"] svg {
    display: none;
}

.mx_MessageComposer_row [aria-label="Attachment"] > div {
    width: 22px;
    height: 22px;
    background:
        linear-gradient(currentColor, currentColor) center / 2px 14px no-repeat,
        linear-gradient(currentColor, currentColor) center / 14px 2px no-repeat;
    color: var(--cirqle-ink-2);
}

.mx_MessageComposer_row .cirqle_mic {
    background: var(--cirqle-green);
    color: #ffffff;
}

.mx_MessageComposer_row .cirqle_mic svg {
    width: 20px;
    height: 20px;
    color: #ffffff;
}

/* While there is text the send button takes the microphone's place */
.mx_MessageComposer_row:has(.mx_MessageComposer_sendMessage) .cirqle_mic {
    display: none;
}

.mx_MessageComposer_sendMessage {
    background: var(--cirqle-green) !important;
}

/* ---------- recording a voice message (cirqle/CirqleVoiceRecorder.tsx) ----------
   As on WhatsApp Web the recorder takes the whole row: the input goes away and
   delete, the red dot with the time, the waveform (paused: the playback, with
   seek and speed) and pause or continue sit at the right, before the send button. */

.mx_MessageComposer_row:has(.cirqle_VoiceRecorder) > .mx_SendMessageComposer,
.mx_MessageComposer_row:has(.cirqle_VoiceRecorder) > .mx_SendWysiwygComposer {
    display: none;
}

.mx_MessageComposer_row > .mx_MessageComposer_actions > .cirqle_VoiceRecorder {
    order: 3;
    flex: 1 1 auto;
    width: auto;
    min-width: 0;
    height: 44px;
    border-radius: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
}

.cirqle_VoiceRecorder_button {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 22px;
    background: none;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cirqle-ink-2);
    cursor: pointer;
}

.cirqle_VoiceRecorder_button:hover {
    background: var(--cirqle-ground);
}

.cirqle_VoiceRecorder_button:disabled {
    opacity: 0.4;
    cursor: default;
}

.cirqle_VoiceRecorder_button svg {
    width: 24px;
    height: 24px;
}

.cirqle_VoiceRecorder_red {
    color: var(--cirqle-record);
}

.cirqle_VoiceRecorder .mx_VoiceMessagePrimaryContainer {
    flex: 0 1 auto;
    min-width: 0;
    max-width: none;
    height: 44px;
    box-sizing: border-box;
    margin: 0;
    padding: 0 16px 0 14px;
    border: 0;
    border-radius: 22px;
    background: var(--cirqle-ground);
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--cirqle-ink);
}

.cirqle_VoiceRecorder_dot {
    flex: 0 0 10px;
    height: 10px;
    border-radius: 5px;
    background: var(--cirqle-record);
    animation: cirqle-recording 1.4s ease-in-out infinite;
}

@keyframes cirqle-recording {
    50% {
        opacity: 0.25;
    }
}

.cirqle_VoiceRecorder .mx_VoiceMessagePrimaryContainer .mx_Clock {
    flex: 0 0 auto;
    width: auto;
    min-width: 0;
    padding: 0;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    color: var(--cirqle-ink);
}

/* Narrow rows keep the newest bars: the waveform gives up its oldest ones */
.cirqle_VoiceRecorder .mx_VoiceMessagePrimaryContainer > .mx_Waveform {
    flex: 0 1 auto;
    min-width: 0;
    height: 28px;
    top: 0;
    justify-content: flex-end;
}

/* Paused, the playback's waveform is as wide as before and carries the seek bar */
.cirqle_VoiceRecorder .mx_RecordingPlayback_timelineLayoutMiddle {
    flex: 0 1 auto;
    width: 156px;
    min-width: 0;
    height: 30px;
    margin: 0;
}

/* The live waveform while recording */
.cirqle_VoiceRecorder .mx_VoiceMessagePrimaryContainer > .mx_Waveform .mx_Waveform_bar {
    background-color: var(--cirqle-ink-3);
}

.cirqle_VoiceRecorder .mx_VoiceMessagePrimaryContainer > .mx_Waveform .mx_Waveform_bar.mx_Waveform_bar_100pct {
    background-color: var(--cirqle-whatsapp);
}

.cirqle_VoiceRecorder_failed {
    flex: 0 0 auto;
    font-size: 13px;
    white-space: nowrap;
    color: var(--cirqle-danger);
}

/* ---------- voice messages in the timeline: WhatsApp's bubble ----------
   play, the waveform that fills in as it plays, the length under it; the
   time stays in the bubble's corner. */

.mx_MVoiceMessageBody .mx_VoiceMessagePrimaryContainer {
    width: 300px;
    max-width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 2px 0 0;
    border: 0;
    border-radius: 0;
    background: none;
    display: grid;
    /* the speed pill's column is kept while it is hidden, so the waveform does not jump */
    grid-template-columns: 36px minmax(0, 1fr) 44px;
    grid-template-rows: 32px 18px;
    column-gap: 8px;
    align-items: center;
}

.mx_MVoiceMessageBody .mx_RecordingPlayback_timelineLayoutMiddle {
    grid-row: 1;
    grid-column: 2;
    margin: 0;
}

.mx_MVoiceMessageBody .mx_RecordingPlayback_timelineLayoutMiddle + .mx_Clock {
    grid-row: 2;
    grid-column: 2;
    width: auto;
    min-width: 0;
    padding: 0;
    text-align: left;
    font-size: 12px;
    line-height: 16px;
    font-variant-numeric: tabular-nums;
    color: var(--cirqle-ink-3);
}

/* The waveform as WhatsApp and Telegram draw it (cirqle/CirqleWaveform.ts): no seek dot;
   each bar sits in an equal share of the width, so a press at x lands on the bar under
   it; bars fill dark green as the message plays (`--fill`, the playing one part way);
   silence is low bars, not dots. A press or a drag along it seeks (pointer handlers on
   the waveform); Element's range input stays only for the keyboard. */
.mx_MVoiceMessageBody .mx_RecordingPlayback_timelineLayoutMiddle,
.cirqle_VoiceRecorder .mx_RecordingPlayback_timelineLayoutMiddle {
    --cirqle-bar-played: var(--cirqle-green);
    --cirqle-bar-left: #b3bbb6;
    cursor: pointer;
    touch-action: pan-y;
    user-select: none;
    border-radius: 4px;
}

.mx_MVoiceMessageBody .mx_RecordingPlayback_timelineLayoutMiddle .mx_Waveform,
.cirqle_VoiceRecorder .mx_RecordingPlayback_timelineLayoutMiddle .mx_Waveform {
    width: 100%;
    top: 0;
    justify-content: space-around;
}

.mx_MVoiceMessageBody .mx_RecordingPlayback_timelineLayoutMiddle .mx_Waveform .mx_Waveform_bar,
.cirqle_VoiceRecorder .mx_RecordingPlayback_timelineLayoutMiddle .mx_Waveform .mx_Waveform_bar {
    flex: 0 0 auto;
    width: 3px;
    height: max(5px, calc(var(--barHeight) * 100%));
    margin: 0;
    border: 0;
    border-radius: 1.5px;
    transform: none;
    transition: none;
    background: linear-gradient(
        to right,
        var(--cirqle-bar-played) calc(var(--fill, 0) * 100%),
        var(--cirqle-bar-left) calc(var(--fill, 0) * 100%)
    );
}

/* The recorder's waveform is narrower: thinner bars keep a gap between them */
.cirqle_VoiceRecorder .mx_RecordingPlayback_timelineLayoutMiddle .mx_Waveform .mx_Waveform_bar {
    width: 2px;
    border-radius: 1px;
}

.mx_MVoiceMessageBody .mx_RecordingPlayback_timelineLayoutMiddle .mx_SeekBar,
.cirqle_VoiceRecorder .mx_RecordingPlayback_timelineLayoutMiddle .mx_SeekBar {
    opacity: 0;
    pointer-events: none;
}

.mx_MVoiceMessageBody .mx_RecordingPlayback_timelineLayoutMiddle:has(.mx_SeekBar:focus-visible),
.cirqle_VoiceRecorder .mx_RecordingPlayback_timelineLayoutMiddle:has(.mx_SeekBar:focus-visible) {
    outline: 2px solid var(--cirqle-green);
    outline-offset: 2px;
}

/* Play and pause: the green glyph alone, as WhatsApp draws it, in the bubble and in the recorder */
.mx_MVoiceMessageBody .mx_PlayPauseButton,
.cirqle_VoiceRecorder .mx_PlayPauseButton {
    grid-row: 1;
    grid-column: 1;
    --cpd-icon-button-size: 36px !important;
    background: none;
}

.mx_MVoiceMessageBody .mx_PlayPauseButton *,
.cirqle_VoiceRecorder .mx_PlayPauseButton * {
    color: var(--cirqle-whatsapp);
}

.mx_MVoiceMessageBody .mx_PlayPauseButton svg,
.cirqle_VoiceRecorder .mx_PlayPauseButton svg {
    width: 28px;
    height: 28px;
}

/* Speed (cirqle/CirqleVoiceSpeedButton.tsx): a pill beside the waveform while it plays */
.cirqle_VoiceSpeed {
    flex: 0 0 auto;
    min-width: 40px;
    height: 24px;
    margin: 0;
    padding: 0 8px;
    border: 0;
    border-radius: 12px;
    background: var(--cirqle-whatsapp);
    color: #ffffff;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    line-height: 24px;
    cursor: pointer;
}

.mx_MVoiceMessageBody .cirqle_VoiceSpeed {
    grid-row: 1;
    grid-column: 3;
}

/* A voice bubble keeps its width on phones, where 62% leaves the waveform no room */
[class*="_layoutBubble_"]:has(> [data-testid="event-tile-slot-sender"] *):has(.mx_MVoiceMessageBody) {
    grid-template-columns: fit-content(85%);
}

/* Element draws media without a bubble; a voice message keeps its bubble */
[class*="_layoutBubble_"] > [data-testid="event-tile-line"]:has(.mx_MVoiceMessageBody) {
    background: var(--event-tile-bubble-other-background);
    padding-inline: 10px;
    padding-bottom: 6px;
}

[class*="_layoutBubble_"][class*="_stateOwnEvent_"] > [data-testid="event-tile-line"]:has(.mx_MVoiceMessageBody) {
    background: var(--event-tile-bubble-self-background);
}

[class*="_layoutBubble_"]:not(:has(> [data-testid="event-tile-slot-sender"] *))
    > [data-testid="event-tile-line"]:has(.mx_MVoiceMessageBody) {
    padding-top: 8px;
}

/* ---------- empty side ---------- */

.cirqle_Empty {
    flex: 1 1 auto;
    height: 100%;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    box-sizing: border-box;
    background: var(--cirqle-ground);
    font-family: Inter, system-ui, sans-serif;
    color: var(--cirqle-ink);
}

.cirqle_Empty_content {
    max-width: 460px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
}

.cirqle_Empty_mark {
    width: 120px;
    height: 120px;
    margin-bottom: 8px;
    border-radius: 32px;
    background: var(--cirqle-green);
    display: flex;
    align-items: center;
    justify-content: center;
}

.cirqle_Empty_mark img {
    width: 62px;
    height: 70px;
    object-fit: contain;
}

.cirqle_Empty_title {
    margin: 0;
    font-family: var(--cirqle-serif);
    font-weight: 600;
    font-size: 30px;
    line-height: normal;
    color: var(--cirqle-green);
}

.cirqle_Empty_text {
    margin: 0;
    font-size: 15px;
    line-height: 22px;
    color: var(--cirqle-ink-2);
}

.cirqle_Empty_actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-top: 18px;
}

.cirqle_Empty_action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    border: 0;
    padding: 0;
    background: transparent;
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    color: var(--cirqle-ink);
    cursor: pointer;
}

.cirqle_Empty_actionIcon {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background: #ffffff;
    border: 1px solid var(--cirqle-line);
    color: var(--cirqle-green);
    display: flex;
    align-items: center;
    justify-content: center;
}

.cirqle_Empty_action:hover .cirqle_Empty_actionIcon {
    border-color: var(--cirqle-green);
}

/* A message, edit or delete WhatsApp or Telegram refused (CirqleDelivery) */
/* The body slot is display: contents inside the tile's flex line, so the notice wraps to its own row */
.mx_EventTile_line:has(.cirqle_DeliveryNotice) {
    flex-wrap: wrap;
}

.cirqle_DeliveryNotice {
    flex-basis: 100%;
    margin-top: 4px;
    font-size: 12px;
    line-height: 16px;
    color: var(--cirqle-danger);
}

.cirqle_DeliveryNotice::before {
    content: "! ";
    font-weight: 700;
}

/* A message's menu opens with a row of reactions, as on WhatsApp (CirqleMessageMenu.tsx) */
.cirqle_QuickReactions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    padding: 6px 8px;
    border-bottom: 1px solid var(--cpd-color-border-interactive-secondary);
}

.cirqle_QuickReactions button {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 20px;
    background: transparent;
    font-size: 24px;
    line-height: 40px;
    padding: 0;
    cursor: pointer;
}

.cirqle_QuickReactions button:hover,
.cirqle_QuickReactions button:focus-visible,
.cirqle_QuickReactions button[aria-pressed="true"] {
    background: var(--cirqle-green-soft);
}

.cirqle_QuickReactions .cirqle_QuickReactions_more {
    background: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-text-secondary);
    font-size: 22px;
}
