/*
Copyright 2026 CIRQLE.

SPDX-License-Identifier: AGPL-3.0-only

Phone-wide windows (concept artboard Phone): no rail, the list fills the
window; an open chat covers the list and has a back arrow. A phone turned
sideways (wider than 767 px, but low) keeps this layout too, as WhatsApp does;
the query is CIRQLE_PHONE_QUERY in CirqleMobile.ts.

Element's resizable panels (the children of the panel group under
.mx_MatrixChat) set their sizes inline, so the overrides here need !important.
*/

.cirqle_RoomHeader_back,
.cirqle_ChatList_fab {
    display: none;
}

@media (max-width: 767px), (pointer: coarse) and (max-height: 500px) {
    .cirqle_Rail,
    .mx_Separator {
        display: none !important;
    }

    /* No chat open: only the list */
    .mx_MatrixChat:not(:has(.mx_RoomView)) > div > div:has(.mx_LeftPanel_outerWrapper) {
        flex: 1 1 100% !important;
        max-width: none !important;
        width: 100% !important;
    }

    .mx_MatrixChat:not(:has(.mx_RoomView)) > div > div:has(.mx_RoomView_wrapper) {
        display: none !important;
    }

    /* A chat open: only the chat */
    .mx_MatrixChat:has(.mx_RoomView) > div > div:has(.mx_LeftPanel_outerWrapper) {
        display: none !important;
    }

    .mx_MatrixChat:has(.mx_RoomView) > div > div:has(.mx_RoomView_wrapper) {
        flex: 1 1 100% !important;
        max-width: none !important;
        width: 100% !important;
    }

    /* A wide message (a video, a long link) never makes the chat wider than the
       screen: Element's flex columns otherwise grow to their content and the page
       slides sideways, header icons and the microphone with it */
    .mx_RoomView_wrapper,
    .mx_RoomView,
    .mx_MainSplit,
    .mx_RoomView_body,
    .mx_RoomView_timeline,
    .mx_RoomView_messagePanel {
        min-width: 0;
        max-width: 100%;
    }

    .mx_RoomView_messagePanel {
        overflow-x: hidden;
    }

    .cirqle_RoomHeader_back {
        display: flex;
        margin-inline-start: -8px;
    }

    .mx_RoomHeader.mx_RoomHeader {
        padding: 10px 12px;
        gap: 10px;
    }

    /* Group info (or contact info) covers the chat; Element's resizable wrapper around it
       is positioned and sized inline */
    .mx_RightPanel_ResizeWrapper,
    .mx_RightPanel {
        position: absolute !important;
        inset: 0;
        z-index: 20;
        width: 100% !important;
        max-width: none !important;
    }

    /* The timeline's floating buttons (to the first unread, to the bottom) sit at
       z-index 1000 and showed through the info panel */
    .mx_MainSplit:has(.mx_RightPanel) .mx_JumpToBottomButton,
    .mx_MainSplit:has(.mx_RightPanel) .mx_TopUnreadMessagesBar {
        display: none;
    }

    .cirqle_ChatList {
        position: relative;
        border-right: 0;
    }

    .cirqle_ChatList_header {
        justify-content: space-between;
        padding: 24px 20px 12px;
    }

    .cirqle_ChatList_title {
        flex: 0 1 auto;
        font-size: 30px;
    }

    /* New chat is the FAB; the menu (New group, Channels, Settings, Profile, Sign out) stays */
    .cirqle_ChatList_header > .cirqle_iconButton:not([aria-haspopup]) {
        display: none;
    }

    .cirqle_NumberPicker_pill {
        height: 40px;
        border-radius: 20px;
        font-size: 14px;
    }

    .cirqle_ChatList_search {
        height: 42px;
        border-radius: 21px;
        margin: 0 20px 10px;
    }

    .cirqle_ChatList_search input {
        font-size: 16px;
    }

    /* The FAB does not cover the last chat */
    .cirqle_ChatList_rows {
        padding-bottom: 96px;
    }

    .cirqle_ChatList_chips {
        padding: 0 20px 12px;
    }

    .cirqle_ChatList_chips .cirqle_chip {
        height: 34px;
        border-radius: 17px;
        font-size: 14px;
    }

    .cirqle_ChatList_chips .cirqle_chip_favourites {
        display: none;
    }

    .cirqle_ChatRow {
        padding: 10px 20px 0;
    }

    .cirqle_ChatRow > .mx_BaseAvatar,
    .cirqle_ChatRow > span:first-child {
        flex-basis: 52px;
        width: 52px !important;
        height: 52px !important;
    }

    .cirqle_ChatRow_name {
        font-size: 16px;
    }

    .cirqle_ChatList_fab {
        position: absolute;
        right: 20px;
        bottom: 28px;
        z-index: 5;
        height: 56px;
        padding: 0 20px;
        border: 0;
        border-radius: 28px;
        background: var(--cirqle-green);
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 10px;
        font: inherit;
        font-size: 15px;
        font-weight: 600;
        box-shadow: 0 6px 18px rgba(14, 59, 46, 0.28);
        cursor: pointer;
    }

    .mx_RoomView_body[data-layout="bubble"],
    [class*="_layoutBubble_"] {
        --event-tile-bubble-line-max-width: 80%;
        --event-tile-bubble-margin-inline-start: 12px;
        --event-tile-bubble-margin-inline-end: 12px;
    }

    .mx_MessageComposer.mx_MessageComposer {
        padding: 8px 10px;
    }

    .cirqle_Empty {
        display: none;
    }

    /* Settings and Profile, opened from the list's menu, take the whole screen */
    .mx_Dialog_border:has(> .mx_Dialog > .mx_UserSettingsDialog) {
        position: fixed;
        inset: 0;
        box-sizing: border-box;
        width: 100%;
        height: 100%;
        max-width: none;
        max-height: none;
        padding: 0;
        border-radius: 0;
    }

    .mx_Dialog:has(> .mx_UserSettingsDialog) {
        width: 100%;
        max-width: none;
        height: 100%;
        max-height: none;
        border-radius: 0;
        padding: calc(16px + env(safe-area-inset-top, 0px)) calc(12px + env(safe-area-inset-right, 0px))
            calc(12px + env(safe-area-inset-bottom, 0px)) calc(12px + env(safe-area-inset-left, 0px));
    }

    .mx_UserSettingsDialog.mx_Dialog_fixedWidth {
        width: 100%;
        max-width: none;
        height: 100%;
    }

    .mx_UserSettingsDialog .mx_TabbedView .mx_SettingsTab {
        min-width: 0;
        padding-right: 2px;
    }

    .mx_UserSettingsDialog .mx_TabbedView_tabPanel {
        min-width: 0;
    }

    .mx_UserSettingsDialog .mx_UserProfileSettings_profile_buttons {
        flex-wrap: wrap;
    }
}

/* Touch screens. Safari zooms into any field with text under 16 px and keeps the
   page zoomed after the keyboard closes. */
@media (pointer: coarse) {
    input,
    textarea,
    select,
    [contenteditable="true"],
    .mx_BasicMessageComposer_input {
        font-size: 16px !important;
    }
}

/* The app is as tall as what the keyboard leaves (CirqleMobile.ts sets the two
   variables from the visual viewport), so the document never scrolls: the
   header stays, the composer rises with the keyboard. */
.cirqle_viewport body {
    overflow: hidden;
    overscroll-behavior: none;
}

.cirqle_viewport #matrixchat {
    position: fixed;
    inset-inline: 0;
    top: var(--cirqle-app-top, 0px);
    height: var(--cirqle-app-height, 100dvh) !important;
}

/* A long press opens the message's menu (CirqleMobile.ts), so a tap does not
   bring up the desktop hover bar, and the press does not select text */
.cirqle_touch .mx_RoomView_body .mx_EventTile {
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
}

.cirqle_touch .mx_RoomView_body .mx_MessageActionBar {
    display: none !important;
}

/* On a phone the message menu and the emoji picker it opens are sheets at the
   bottom over a dimmed chat, with finger-sized rows */
@media (max-width: 767px), (pointer: coarse) and (max-height: 500px) {
    .mx_ContextualMenu_wrapper:has(.mx_MessageContextMenu),
    .cirqle_ReactionPickerMenu {
        position: fixed;
        inset: auto 8px calc(8px + env(safe-area-inset-bottom, 0px)) !important;
    }

    .mx_ContextualMenu_wrapper:has(.mx_MessageContextMenu) > .mx_ContextualMenu_background,
    .cirqle_ReactionPickerMenu > .mx_ContextualMenu_background {
        background: rgba(20, 32, 25, 0.35);
    }

    .mx_ContextualMenu:has(.mx_MessageContextMenu),
    .cirqle_ReactionPickerMenu .mx_ContextualMenu {
        position: relative;
        inset: auto;
        width: 100%;
        max-height: 70vh;
        overflow-y: auto;
        border-radius: 16px;
    }

    .mx_MessageContextMenu.mx_MessageContextMenu {
        width: 100%;
        max-width: none;
    }

    .mx_MessageContextMenu .mx_IconizedContextMenu_item {
        min-height: 48px;
        font-size: 16px;
    }

    /* A finger opened it: no keyboard focus ring on the first row */
    .cirqle_touch .mx_MessageContextMenu :focus {
        outline: none;
    }

    .cirqle_ReactionPickerMenu .mx_ContextualMenu > * {
        width: 100%;
    }

    .cirqle_ReactionPickerMenu [class*="mx_ContextualMenu_chevron"] {
        display: none;
    }
}

/* Installed on the home screen (viewport-fit=cover in index.html): the app keeps
   clear of the notch, the home indicator and, on a phone turned sideways, the
   rounded corners; the strips are the app's white. With the keyboard up, the
   home indicator is under it, so nothing is kept below the composer. */
#matrixchat {
    box-sizing: border-box;
    padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px)
        env(safe-area-inset-left, 0px);
    background: #ffffff;
}

.cirqle_keyboard #matrixchat {
    padding-bottom: 0;
}
